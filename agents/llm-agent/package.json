{
  "name": "llm-agent",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "dev:careful": "ts-node-dev --env-file=../../.env --respawn --transpile-only src/server.ts careful",
    "dev:reckless": "ts-node-dev --env-file=../../.env --respawn --transpile-only src/server.ts reckless",
    "build": "tsc -p tsconfig.json",
    "start:careful": "node --env-file=../../.env dist/server.js careful",
    "start:reckless": "node --env-file=../../.env dist/server.js reckless"
  },
  "dependencies": {
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.0"
  }
}
