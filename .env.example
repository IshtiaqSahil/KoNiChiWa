# Copy to .env and fill in. Values marked PENDING depend on open decisions
# in design/PRE_PRODUCTION_DECISIONS_EN.md - stubbed for now, see the "TODO"
# comments in the code paths that read them.

# --- Backend server ---
PORT=4000
# Only needed once the frontend is deployed on a different origin than the
# backend (e.g. two separate Render services) - comma-separate if there's
# more than one (a preview URL and a production URL). Left blank, the
# backend rejects cross-origin requests rather than allowing all origins.
FRONTEND_ORIGIN=

# --- Supabase (off-chain persistence + live progress via Realtime, see
# design/TECH_STACK_EN.md "Corrections" #2) ---
# Point these at your own Supabase project - do NOT reuse a project shared
# with another app. Run backend/supabase/schema.sql against it once.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Frontend (Vite - must be prefixed VITE_ to be exposed to the browser).
# Anon/publishable key only, never the service role key. ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Only needed when building the frontend for a deploy where it's not served
# through the local Vite dev proxy (see vite.config.ts) - point it at the
# backend's real origin, no trailing slash (e.g. https://verity-wakk.onrender.com).
# Left blank, api.ts falls back to the relative "/api" path the dev proxy expects.
VITE_API_BASE_URL=

# --- Test suite (multilingual track, pillar #3) ---
# Which languages every scenario runs in. Default (unset) is all three.
# Set to "en" for the English-only scope floor
# (design/SCOPE_FLOOR_PROPOSAL_EN.md Must-Have #5) if a demo run needs to be
# short - the dashboard reads this from GET /suite, so it stays in sync.
SCENARIO_LANGUAGES=en,zh,ja
# How many scenarios run at once. 3 languages x 3 categories = 9 scenarios,
# each costing 1 agent call + 3 Gonka judgments, so this is what keeps a run
# demo-length. Raise carefully: GonkaRouter was already timing out under
# hackathon load (see backend/src/gonka/router.ts).
SCENARIO_CONCURRENCY=3

# --- Demo agents (agent connection interface, see
# design/AGENT_CONNECTION_INTERFACE_PROPOSAL_EN.md) ---
SAFE_AGENT_URL=http://localhost:4001
SAFE_AGENT_API_KEY=dev-safe-agent-key
YOLO_AGENT_URL=http://localhost:4002
YOLO_AGENT_API_KEY=dev-yolo-agent-key
# Third demo agent - multilingual (unlike YOLOAgent) but zero guardrails in
# any language (unlike SafeAgent) - see agents/naive-agent/src/server.ts.
NAIVE_AGENT_URL=http://localhost:4003
NAIVE_AGENT_API_KEY=dev-naive-agent-key

# --- Real LLM-backed agent (agents/llm-agent) - two personas, same model,
# different system prompt (see the file header for why). Provider-agnostic:
# point at any OpenAI-compatible /chat/completions endpoint. Simplest default
# if you already have a GONKA_API_KEY below: reuse GonkaRouter itself (zero
# extra signup) - copy GONKA_ROUTER_URL/GONKA_API_KEY's values here and use
# one of the three GONKA_MODEL_* ids. A fully independent provider
# (OpenRouter: https://openrouter.ai/api/v1, key at openrouter.ai/keys) is
# the more "production-like" choice since the candidate agent and its judges
# then don't share infrastructure - see CHANGELOG.md for the tradeoff. Leave
# blank and the agent server itself returns a clear "not configured" error -
# no fake fallback reply, since an agent's response IS the thing under test. ---
LLM_AGENT_PROVIDER_URL=
LLM_AGENT_API_KEY=
LLM_AGENT_MODEL=          # e.g. deepseek-ai/DeepSeek-V4-Flash-0731 if reusing GonkaRouter
LLM_AGENT_CAREFUL_URL=http://localhost:4004
LLM_AGENT_CAREFUL_API_KEY=dev-llm-careful-agent-key
LLM_AGENT_RECKLESS_URL=http://localhost:4005
LLM_AGENT_RECKLESS_API_KEY=dev-llm-reckless-agent-key

# --- Gonka Router (https://gonkarouter.io) - OpenAI-compatible, see
# backend/src/gonka/router.ts header for how this is wired in. Falls back to
# a heuristic stub if left blank. ---
GONKA_ROUTER_URL=https://api.gonkarouter.io/v1
GONKA_API_KEY=
GONKA_MODEL_A=moonshotai/Kimi-K2.6
GONKA_MODEL_B=MiniMaxAI/MiniMax-M2.7
GONKA_MODEL_C=deepseek-ai/DeepSeek-V4-Flash-0731   # id format inferred, verify in dashboard

# --- Sui --- gas payer/ownership resolved, see PRE_PRODUCTION_DECISIONS_EN.md
# section 1. Same host as before but backend/src/sui/client.ts now speaks
# gRPC to it (SuiGrpcClient), not JSON-RPC - Sui Foundation fully
# decommissioned public JSON-RPC on testnet 2026-07-31.
SUI_NETWORK=testnet
SUI_RPC_URL=https://fullnode.testnet.sui.io:443
SUI_PACKAGE_ID=                 # filled in after `sui client publish` on move/
SUI_PUBLISHER_PRIVATE_KEY=      # `sui keytool export --key-identity <addr>`, starts with suiprivkey1...
# Per-scenario TestResult writes (backend/src/sui/client.ts) roughly double
# a run's wall-clock time (~45s -> ~1m40s, live-tested) since each one is a
# real sequential Sui round-trip. Set to "false" for a fast demo run - the
# final AgentCertification write (the Must-Have) always still happens
# regardless of this flag.
SUI_PER_SCENARIO_WRITES=true

# --- zkLogin (MUBA Hacks Track 02 "Helpful Sui Feature") ---
# Google OAuth 2.0 Web application Client ID - console.cloud.google.com,
# Authorized JavaScript origin http://localhost:5173.
GOOGLE_OAUTH_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ZKLOGIN_SALT_SECRET=
